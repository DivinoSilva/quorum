{
  "uid": "quorum-votes-business",
  "title": "Quorum — Votes & Business",
  "tags": ["quorum"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total de votos",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "datasource": "Prometheus",
      "targets": [
        { "refId": "A", "datasource": "Prometheus", "expr": "sum(votes_total)" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Votos/seg (janela 1m)",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "datasource": "Prometheus",
      "targets": [
        { "refId": "A", "datasource": "Prometheus", "expr": "sum(rate(votes_total[1m]))" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "decimals": 1 }, "overrides": [] },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Progresso até a meta de pico (1000 votos/seg)",
      "description": "% da meta de pico do desafio (1000 votos/seg) que o tráfego atual representa.",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "datasource": "Prometheus",
      "targets": [
        { "refId": "A", "datasource": "Prometheus", "expr": "100 * sum(rate(votes_total[1m])) / 1000" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "piechart",
      "title": "Votos por candidato",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 6 },
      "datasource": "Prometheus",
      "targets": [
        {
          "refId": "A",
          "datasource": "Prometheus",
          "expr": "sum by (candidate_name) (votes_total)",
          "legendFormat": "{{candidate_name}}"
        }
      ],
      "fieldConfig": { "defaults": { "decimals": 0 }, "overrides": [] },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] },
        "pieType": "pie"
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Votos por segundo, por candidato",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 6 },
      "datasource": "Prometheus",
      "targets": [
        {
          "refId": "A",
          "datasource": "Prometheus",
          "expr": "sum by (candidate_name) (rate(votes_total[1m]))",
          "legendFormat": "{{candidate_name}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    }
  ]
}
